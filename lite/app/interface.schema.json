{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oligo Lite result v2",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "chemistry",
    "optical",
    "graph"
  ],
  "properties": {
    "schema_version": {
      "const": "oligo-lite/2"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "chemistry": {
      "type": [
        "object",
        "null"
      ]
    },
    "optical": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "ESTIMATED",
            "NEEDS_PARAMETER",
            "UNSUPPORTED"
          ]
        },
        "epsilon260": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nmol_per_od": {
          "type": "number"
        },
        "ug_per_od": {
          "type": "number"
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "graph": {
      "type": [
        "object",
        "null"
      ]
    },
    "assembly_graph": {
      "$ref": "core.schema.json#/$defs/AssemblyGraph"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "assembly_graph"
        ]
      }
    }
  ]
}
