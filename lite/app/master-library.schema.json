{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master Library v2",
  "type": "object",
  "required": [
    "schema_version",
    "blocks",
    "linkages"
  ],
  "properties": {
    "schema_version": {
      "const": "master-library/2"
    },
    "blocks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "core.schema.json#/$defs/BuildingBlock"
      }
    },
    "linkages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "core.schema.json#/$defs/LinkageDefinition"
      }
    }
  }
}
