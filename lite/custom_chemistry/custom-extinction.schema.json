{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "contribution",
    "source"
  ],
  "properties": {
    "model": {
      "const": "additive-full-unit"
    },
    "contribution": {
      "type": "number",
      "minimum": 0
    },
    "correction": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  }
}